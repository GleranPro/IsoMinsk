{
  "name": "isometric-minsk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive isometric pixel-art 3D map of Minsk, built from OpenStreetMap data",
  "scripts": {
    "dev": "vite",
    "dev:data": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:data": ".venv\\Scripts\\python.exe -m unittest discover -s scripts/normalize/tests -p \"test_*.py\" -v",
    "test:e2e": "playwright test",
    "qa:capture": "node scripts/qa/capture.mjs",
    "qa:buildings:gallery": "node scripts/qa/building-gallery-capture.mjs --ci",
    "qa:buildings:capture": "node scripts/qa/building-review-capture.mjs --cases docs/building-quality/review-cases.json --mode candidate",
    "qa:buildings:audit": ".venv\\Scripts\\python.exe scripts/qa/building_contract_audit.py --before-dir public/data/city-tiles --after-dir data/staging/city-buildings --out docs/building-quality/style-audit.json",
    "qa:buildings:serve": "node scripts/qa/serve-building-candidate.mjs --tiles-dir data/staging/city-buildings",
    "site:build": "node scripts/qa/build-pages.mjs --dist dist --site .pages --city-dir public/data/city-tiles",
    "site:audit": "node scripts/qa/publication-audit.mjs --site .pages",
    "site:audit:static": "node scripts/qa/publication-audit.mjs --site .pages --static-only",
    "qa:road-audit": ".venv\\Scripts\\python.exe scripts/qa/road-audit.py",
    "qa:road-paint-audit": "tsx scripts/qa/road-paint-audit.ts",
    "qa:road-shots": "node scripts/qa/road-shots.mjs",
    "data:download": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ingest/download.ps1",
    "data:extract": ".venv\\Scripts\\python.exe scripts/ingest/extract.py --area pilot",
    "data:normalize": ".venv\\Scripts\\python.exe scripts/normalize/normalize.py --area pilot",
    "data:validate": ".venv\\Scripts\\python.exe scripts/validation/coverage_report.py --area pilot",
    "data:all": "npm run data:download && npm run data:extract && npm run data:normalize && npm run data:validate",
    "data:city:extract": ".venv\\Scripts\\python.exe scripts/ingest/extract.py --area city",
    "data:city:normalize": ".venv\\Scripts\\python.exe scripts/normalize/normalize.py --area city",
    "data:city:validate": ".venv\\Scripts\\python.exe scripts/validation/coverage_report.py --area city",
    "data:city": "npm run data:download && npm run data:city:extract && npm run data:city:normalize && npm run data:city:validate",
    "data:museum": ".venv\\Scripts\\python.exe scripts/qa/export_museum_web.py",
    "landmarks:fit": ".venv\\Scripts\\python.exe scripts/landmarks/fit_placements.py",
    "landmarks:bake": ".venv\\Scripts\\python.exe scripts/landmarks/bake_landmarks.py",
    "data:rail": ".venv\\Scripts\\python.exe scripts/models/extract_rail_network.py",
    "models:transport": "node scripts/models/run_transport_models.mjs",
    "models:transport:preview": "node scripts/models/run_transport_models.mjs --render",
    "test:mobility": ".venv\\Scripts\\python.exe -m unittest discover -s scripts/mobility/tests -p \"test_*.py\" -v",
    "data:mobility:extract": ".venv\\Scripts\\python.exe scripts/mobility/extract_network.py",
    "data:mobility:build": ".venv\\Scripts\\python.exe scripts/mobility/build_network.py",
    "data:mobility:export": ".venv\\Scripts\\python.exe scripts/mobility/export.py",
    "data:mobility:schedule": ".venv\\Scripts\\python.exe scripts/mobility/import_schedule.py",
    "qa:mobility-audit": ".venv\\Scripts\\python.exe scripts/qa/mobility-audit.py",
    "data:mobility:city:corridors": ".venv\\Scripts\\python.exe scripts/mobility/extract_network.py --write-city-corridors scripts/mobility/corridors_city.json",
    "data:mobility:city:extract": ".venv\\Scripts\\python.exe scripts/mobility/extract_network.py --corridors scripts/mobility/corridors_city.json --out data/processed/mobility/network_raw_city.json",
    "data:mobility:city:build": ".venv\\Scripts\\python.exe scripts/mobility/build_network.py --raw data/processed/mobility/network_raw_city.json --out data/processed/mobility/network_city.json --report data/processed/mobility/report_city.json --allow-unverified",
    "data:mobility:city:export": ".venv\\Scripts\\python.exe scripts/mobility/export.py --network data/processed/mobility/network_city.json --out public/data/mobility-city --timetable=procedural",
    "data:mobility:city:audit": ".venv\\Scripts\\python.exe scripts/qa/mobility-audit.py --base public/data/mobility-city --out data/processed/mobility/audit-city.json",
    "qa:mobility-capture": "node scripts/qa/mobility-capture.mjs",
    "qa:mobility-perf": "node scripts/qa/mobility-perf.mjs",
    "qa:liveness-perf": "node scripts/qa/liveness-perf.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
