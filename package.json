{
  "name": "isometric-minsk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive isometric pixel-art 3D map of Minsk, built from OpenStreetMap data",
  "scripts": {
    "dev": "vite",
    "dev:data": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:data": ".venv\\Scripts\\python.exe -m unittest discover -s scripts/normalize/tests -p \"test_*.py\" -v",
    "test:e2e": "playwright test",
    "qa:capture": "node scripts/qa/capture.mjs",
    "qa:buildings:gallery": "node scripts/qa/building-gallery-capture.mjs --ci",
    "qa:buildings:capture": "node scripts/qa/building-review-capture.mjs --cases docs/building-quality/review-cases.json --mode candidate",
    "qa:buildings:audit": ".venv\\Scripts\\python.exe scripts/qa/building_contract_audit.py --before-dir public/data/city-tiles --after-dir data/staging/city-buildings --out docs/building-quality/style-audit.json",
    "qa:buildings:serve": "node scripts/qa/serve-building-candidate.mjs --tiles-dir data/staging/city-buildings",
    "site:build": "node scripts/qa/build-pages.mjs --dist dist --site .pages --city-dir public/data/city-tiles",
    "site:audit": "node scripts/qa/publication-audit.mjs --site .pages",
    "site:audit:static": "node scripts/qa/publication-audit.mjs --site .pages --static-only",
    "qa:road-audit": ".venv\\Scripts\\python.exe scripts/qa/road-audit.py",
    "qa:road-paint-audit": "tsx scripts/qa/road-paint-audit.ts",
    "qa:road-shots": "node scripts/qa/road-shots.mjs",
    "data:download": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ingest/download.ps1",
    "data:extract": ".venv\\Scripts\\python.exe scripts/ingest/extract.py --area pilot",
    "data:normalize": ".venv\\Scripts\\python.exe scripts/normalize/normalize.py --area pilot",
    "data:validate": ".venv\\Scripts\\python.exe scripts/validation/coverage_report.py --area pilot",
    "data:all": "npm run data:download && npm run data:extract && npm run data:normalize && npm run data:validate",
    "data:city:extract": ".venv\\Scripts\\python.exe scripts/ingest/extract.py --area city",
    "data:city:normalize": ".venv\\Scripts\\python.exe scripts/normalize/normalize.py --area city",
    "data:city:validate": ".venv\\Scripts\\python.exe scripts/validation/coverage_report.py --area city",
    "data:city": "npm run data:download && npm run data:city:extract && npm run data:city:normalize && npm run data:city:validate",
    "data:museum": ".venv\\Scripts\\python.exe scripts/qa/export_museum_web.py"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
